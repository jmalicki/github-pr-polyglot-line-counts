{
  "name": "github-pr-polyglot-line-counts",
  "version": "0.0.3",
  "description": "Language-aware line count statistics for GitHub pull requests with review time estimates",
  "main": "content.js",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-tests.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:visibility": "tsx tests/intermittent/panel-visibility.test.ts",
    "test:stability": "tsx tests/intermittent/page-stability-race.test.ts",
    "test:concurrent": "tsx tests/intermittent/concurrent-analyze.test.ts",
    "test:api-reuse": "tsx tests/intermittent/api-promise-reuse.test.ts",
    "test:reinjection": "tsx tests/intermittent/script-reinjection.test.ts",
    "test:intermittent": "npm run test:visibility -- --env ITERATIONS=20",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,ts}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,ts}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "chrome-extension",
    "github",
    "pull-request",
    "language-stats",
    "code-review"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.37.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "puppeteer": "^24.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
